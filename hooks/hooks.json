{
  "description": "Jarvis mode and shortmode toggles, and spoken replies",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "comment": [
              "Write the reply to ~/.claude/last-message.txt, then read it",
              "aloud with Kokoro in jarvis mode.",
              "Chained with && so those things run in sequence."
            ],
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/write-last-message.sh\" && \"${CLAUDE_PLUGIN_ROOT}/scripts/jarvis-speak.sh\"",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "comment": [
              "Prompts 'jarvis', 'shortmode' and their 'off' forms switch",
              "the mode in ~/.claude/barn-claude-jarvis-mode. Injects the",
              "active mode's reply rule into every prompt."
            ],
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/mode-hook.sh\""
          }
        ]
      }
    ]
  }
}
