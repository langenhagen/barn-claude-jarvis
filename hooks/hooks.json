{
  "description": "Jarvis mode, shortmode and Friday mode toggles, and spoken replies",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "comment": [
              "Approve writes to",
              "~/.cache/barn-claude-jarvis/last-friday-message.txt without a",
              "permission prompt."
            ],
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/approve-friday-message-write.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "comment": [
              "Write the reply to",
              "~/.cache/barn-claude-jarvis/last-jarvis-message.txt, then read it",
              "aloud with Kokoro in Jarvis mode.",
              "Chained with && so jarvis-speak.sh reads this turn's reply, not",
              "the previous one."
            ],
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/write-jarvis-message.sh\" && \"${CLAUDE_PLUGIN_ROOT}/scripts/jarvis-speak.sh\"",
            "async": true
          },
          {
            "type": "command",
            "comment": [
              "Read ~/.cache/barn-claude-jarvis/last-friday-message.txt aloud",
              "in Friday mode."
            ],
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/friday-speak.sh\"",
            "async": true
          },
          {
            "type": "command",
            "comment": [
              "In Friday mode, send the model back once if it did not write",
              "~/.cache/barn-claude-jarvis/last-friday-message.txt."
            ],
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/ensure-friday-message.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "comment": [
              "Prompts 'jarvis', 'shortmode', 'friday' and their 'off' forms",
              "switch the mode in ~/.cache/barn-claude-jarvis/mode. Injects",
              "the active mode's reply rule into every prompt."
            ],
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/mode-hook.sh\""
          }
        ]
      }
    ]
  }
}
