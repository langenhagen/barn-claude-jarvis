{
  "description": "Jarvis mode, shortmode and friday mode toggles, and spoken replies",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "comment": [
              "Approve writes to ~/.claude/last-jarvis-message.txt without",
              "a permission prompt."
            ],
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/approve-jarvis-message-write.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "comment": [
              "Write the reply to ~/.claude/last-message.txt, then read it",
              "aloud with Kokoro in jarvis mode.",
              "Chained with && so those things run in sequence."
            ],
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/write-last-message.sh\" && \"${CLAUDE_PLUGIN_ROOT}/scripts/jarvis-speak.sh\"",
            "async": true
          },
          {
            "type": "command",
            "comment": [
              "Read ~/.claude/last-jarvis-message.txt aloud in friday mode."
            ],
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/friday-speak.sh\"",
            "async": true
          },
          {
            "type": "command",
            "comment": [
              "In friday mode, send the model back once if it did not write",
              "~/.claude/last-jarvis-message.txt."
            ],
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/friday-stop.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "comment": [
              "Prompts 'jarvis', 'shortmode', 'friday' and their 'off' forms",
              "switch the mode in ~/.claude/barn-claude-jarvis-mode. Injects",
              "the active mode's reply rule into every prompt."
            ],
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/mode-hook.sh\""
          }
        ]
      }
    ]
  }
}
