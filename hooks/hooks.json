{
  "description": "Jarvis mode and shortmode toggles, and spoken replies",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "comment": [
              "Write the reply to ~/.claude/last-message.txt, then read it",
              "aloud with Kokoro if ~/.claude/jarvis exists.",
              "Chained with && so those things run in sequence."
            ],
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/write-last-message.sh\" && \"${CLAUDE_PLUGIN_ROOT}/scripts/jarvis-speak.sh\"",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "comment": [
              "Prompt 'shortmode' or 'shortmode off' toggles",
              "~/.claude/shortmode. While on, injects the terse-reply rule",
              "into every prompt."
            ],
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/shortmode-hook.sh\""
          },
          {
            "type": "command",
            "comment": [
              "Prompt 'jarvis' or 'jarvis off' toggles ~/.claude/jarvis.",
              "While on, injects the terse spoken-reply rule into every",
              "prompt."
            ],
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/jarvis-hook.sh\""
          }
        ]
      }
    ]
  }
}
